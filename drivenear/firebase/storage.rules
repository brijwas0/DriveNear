rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Identity verification documents: Aadhaar & Driving Licence
    match /verification/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf)');
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }

    // Car listing photos are stored in ImageKit (not Firebase Storage).

    // Profile photos
    match /profile-photos/{uid}/{all=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}

